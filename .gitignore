# ---- LocalWP scaffolding ----
/conf/
/logs/
/app/sql/

# ---- WordPress core (managed on server, not versioned) ----
/app/public/wp-admin/
/app/public/wp-includes/
/app/public/wp-*.php
/app/public/index.php
/app/public/xmlrpc.php
/app/public/license.txt
/app/public/readme.html
/app/public/wp-config.php

# ---- Content we don't version ----
/app/public/wp-content/uploads/
/app/public/wp-content/cache/
/app/public/wp-content/upgrade/
/app/public/wp-content/upgrade-temp-backup/
/app/public/wp-content/advanced-cache.php
/app/public/wp-content/object-cache.php
/app/public/wp-content/db.php
/app/public/wp-content/*.log
/app/public/wp-content/debug.log
/app/public/wp-content/litespeed/
/app/public/wp-content/.litespeed_conf.dat

# ---- Third-party plugins: not versioned (redeployable; deploy.sh ships them via tar) ----
# Track only your own code (themes, mu-plugins). To version a specific custom
# plugin, add an un-ignore line, e.g.:  !/app/public/wp-content/plugins/my-plugin/
/app/public/wp-content/plugins/*
!/app/public/wp-content/plugins/vemus-addon/

# ---- Deploy artifacts ----
/.deploy/
*.sql
*.tar.gz

# ---- Editor / OS noise ----
.DS_Store
Thumbs.db
node_modules/
.vscode/
